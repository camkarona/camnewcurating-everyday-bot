# 까로나 뉴스봇 환경변수 예시
# 이 파일을 복사해서 .env 로 저장하고 실제 값을 채우세요.
#   (Windows)  copy .env.example .env
#   (Linux)    cp .env.example .env

# Gemini API 키
GEMINI_API_KEY=여기에_API_키

# 텔레그램 봇 토큰 (@BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=여기에_봇_토큰

# 전송 대상 chat_id (개인 채팅 또는 비공개 그룹)
# 확인법: 봇에게 아무 메시지나 보낸 뒤
#   https://api.telegram.org/bot<봇토큰>/getUpdates 접속 -> chat.id 확인
TELEGRAM_CHAT_ID=여기에_chat_id

# (선택) Gemini 모델명 - 기본값: gemini-3-flash-preview
GEMINI_MODEL=gemini-3-flash-preview
